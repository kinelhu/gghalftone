version: 0.1.0
license: MIT
repository-code: "https://github.com/kinelhu/gghalftone"
url: "https://kinelhu.github.io/gghalftone/"
keywords:
  - R
  - ggplot2
  - halftone
  - data-visualisation
  - scientific-figures
